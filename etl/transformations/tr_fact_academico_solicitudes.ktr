    <connection>pg_proyecto</connection>
    <sql>SELECT s.id_solicitud                AS id_solicitud_origen,
       m.id_matricula                AS id_matricula_origen,
       s.id_estudiante,
       s.id_curso,
       s.id_sede,
       s.id_horario,
       COALESCE(m.id_grupo, -1)      AS id_grupo_origen,
       s.fecha::date                 AS fecha,
       m.nota,
       CASE WHEN s.resultado = 'ASIGNADA'    THEN 1 ELSE 0 END AS es_asignada,
       CASE WHEN s.resultado = 'SIN_CUPO'    THEN 1 ELSE 0 END AS es_sin_cupo,
       CASE WHEN s.resultado = 'NO_ELEGIBLE' THEN 1 ELSE 0 END AS es_no_elegible,
       CASE WHEN s.resultado = 'DESISTIDA'   THEN 1 ELSE 0 END AS es_desistida,
       CASE WHEN m.id_matricula IS NOT NULL  THEN 1 ELSE 0 END AS matricula,
       CASE WHEN m.estado = 'APROBADO'       THEN 1 ELSE 0 END AS es_aprobado,
       CASE WHEN m.estado = 'REPROBADO'      THEN 1 ELSE 0 END AS es_reprobado,
       CASE WHEN m.estado = 'RETIRADO'       THEN 1 ELSE 0 END AS es_retirado,
       CASE WHEN m.estado = 'APROBADO' THEN c.creditos ELSE 0 END AS creditos_aprobados
FROM universidad.solicitud s
JOIN universidad.curso c          ON c.id_curso = s.id_curso
LEFT JOIN universidad.matricula m ON m.id_solicitud = s.id_solicitud;</sql>
    <limit>0</limit>
