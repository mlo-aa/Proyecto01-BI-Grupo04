digraph G { graph [rankdir=TB,bgcolor="white",nodesep=.28,ranksep=.6]; node [shape=record,fontname="Arial",fontsize=12,style=filled,fillcolor="#F3F5F7",color="#6C7881"]; edge [fontname="Arial",fontsize=10,dir=both,arrowtail=tee,arrowhead=odotcrow,color="#53616A"];
estudiante [label="{estudiante|PK id_estudiante|alias}"];
carrera [label="{carrera|PK id_carrera|nombre}"];
periodo [label="{periodo|PK id_periodo|inicio / corte_matricula / fin}"];
trayectoria [label="{trayectoria|PK/FK id_estudiante|PK/FK id_periodo|FK id_carrera|cohorte}"];
solicitud [label="{solicitud|PK id_solicitud|FK estudiante + periodo|FK curso / sede / horario|fecha / resultado}"];
matricula [label="{matricula|PK id_matricula|FK id_solicitud UNIQUE|FK id_grupo|fecha / estado / nota|fecha_retiro}"];
grupo [label="{grupo|PK id_grupo|FK curso / periodo / sede|FK docente / modalidad / horario|numero_grupo / capacidad_corte}"];
curso [label="{curso|PK id_curso|codigo / nombre / creditos}"];
sede [label="{sede|PK id_sede|nombre}"];
docente [label="{docente|PK id_docente|alias}"];
modalidad [label="{modalidad|PK id_modalidad|nombre}"];
horario [label="{horario|PK id_horario|franja}"];
estudiante -> trayectoria;
carrera -> trayectoria;
periodo -> trayectoria;
trayectoria -> solicitud;
curso -> solicitud;
sede -> solicitud;
horario -> solicitud;
solicitud -> matricula [arrowhead=odottee];
grupo -> matricula;
curso -> grupo;
periodo -> grupo;
sede -> grupo;
docente -> grupo;
modalidad -> grupo;
horario -> grupo;
}